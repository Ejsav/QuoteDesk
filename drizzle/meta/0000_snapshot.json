      "checkConstraints": {
        "leads_status_ck": {
          "name": "leads_status_ck",
          "value": "\"leads\".\"status\" in ('new', 'contacted', 'qualified', 'on_hold', 'lost')"
        },
        "leads_lost_reason_ck": {
          "name": "leads_lost_reason_ck",
          "value": "(\"leads\".\"status\" = 'lost' and \"leads\".\"lost_reason\" is not null and \"leads\".\"lost_reason\" in ('no_response', 'chose_competitor', 'budget', 'trip_cancelled', 'not_a_fit', 'duplicate', 'spam', 'other')) or (\"leads\".\"status\" <> 'lost' and \"leads\".\"lost_reason\" is null)"
        },
        "leads_priority_ck": {
          "name": "leads_priority_ck",
          "value": "\"leads\".\"priority\" in ('low', 'normal', 'high', 'urgent')"
        },
        "leads_source_ck": {
          "name": "leads_source_ck",
          "value": "\"leads\".\"source\" in ('website', 'phone', 'email', 'referral', 'partner', 'repeat', 'instagram', 'google', 'other')"
        },
        "leads_occasion_ck": {
          "name": "leads_occasion_ck",
          "value": "(\"leads\".\"occasion\" is null or \"leads\".\"occasion\" in ('wedding', 'corporate', 'airport', 'bachelor', 'birthday', 'nightlife', 'prom', 'concert_sports', 'wine_tour', 'funeral', 'group_event', 'other'))"
        },
        "leads_service_type_ck": {
          "name": "leads_service_type_ck",
          "value": "(\"leads\".\"service_type\" is null or \"leads\".\"service_type\" in ('one_way', 'round_trip', 'hourly'))"
        },
        "leads_vehicle_ck": {
          "name": "leads_vehicle_ck",
          "value": "(\"leads\".\"vehicle_category\" is null or \"leads\".\"vehicle_category\" in ('sedan', 'suv', 'sprinter', 'stretch_limo', 'suv_limo', 'party_bus', 'mini_coach', 'motor_coach', 'trolley', 'no_preference'))"
        },
        "leads_passengers_ck": {
          "name": "leads_passengers_ck",
          "value": "(\"leads\".\"passengers_min\" is null and \"leads\".\"passengers_max\" is null) or (\"leads\".\"passengers_min\" is not null and \"leads\".\"passengers_max\" is not null and \"leads\".\"passengers_min\" >= 1 and \"leads\".\"passengers_max\" >= \"leads\".\"passengers_min\")"
        },
        "leads_budget_ck": {
          "name": "leads_budget_ck",
          "value": "\"leads\".\"budget_cents\" is null or \"leads\".\"budget_cents\" >= 0"
        },
        "leads_duration_ck": {
          "name": "leads_duration_ck",
          "value": "\"leads\".\"duration_minutes\" is null or \"leads\".\"duration_minutes\" > 0"
        },
        "leads_trip_date_ck": {
          "name": "leads_trip_date_ck",
          "value": "(\"leads\".\"trip_date\" is null or \"leads\".\"trip_date\" glob '[0-9][0-9][0-9][0-9]-[0-1][0-9]-[0-3][0-9]')"
        },
        "leads_follow_up_date_ck": {
          "name": "leads_follow_up_date_ck",
          "value": "(\"leads\".\"follow_up_date\" is null or \"leads\".\"follow_up_date\" glob '[0-9][0-9][0-9][0-9]-[0-1][0-9]-[0-3][0-9]')"
        },
        "leads_pickup_time_ck": {
          "name": "leads_pickup_time_ck",
          "value": "\"leads\".\"pickup_time\" is null or (\"leads\".\"trip_date\" is not null and \"leads\".\"pickup_time\" glob '[0-2][0-9]:[0-5][0-9]')"
        },
        "leads_follow_up_note_ck": {
          "name": "leads_follow_up_note_ck",
          "value": "\"leads\".\"follow_up_note\" is null or \"leads\".\"follow_up_date\" is not null"
        },
        "leads_qualified_facts_ck": {
          "name": "leads_qualified_facts_ck",
          "value": "\"leads\".\"status\" <> 'qualified' or (\"leads\".\"trip_date\" is not null and \"leads\".\"pickup_location\" is not null and \"leads\".\"passengers_min\" is not null)"
        }
      }
    },
